# Copy to .env and adjust. Never commit a real key.
# The lane (LOCAL or HOSTED) is derived from MAF_ENDPOINT, not declared here: a loopback host is
# LOCAL, anything else is HOSTED, and every run prints which one it is on.

# LOCAL (offline after prefetch) - Ollama. This is the blessed attendee default.
MAF_ENDPOINT=http://localhost:11434/v1
MAF_API_KEY=ollama
MAF_MODEL=nemotron-3-nano:4b

# Hard ceiling on every single model call, in seconds. Clamped to 5-600. Default 90.
# MAF_TIMEOUT_SECONDS=90

# LOCAL compatibility lane - LM Studio (NOT verified end-to-end; see workshop/CLAIMS-AND-LIMITS.md)
# MAF_ENDPOINT=http://localhost:1234/v1
# MAF_API_KEY=lm-studio
# MAF_MODEL=<the exact model id LM Studio shows>

# CONTROLLED CLOUD recovery lane - organiser-owned, OpenAI-compatible, key-authenticated.
# Any endpoint speaking the OpenAI Chat Completions API works with no code change, including
# Azure OpenAI's /openai/v1 route. The organiser hands out the three values on the day.
# Entra / AzureCliCredential authentication is NOT implemented - see workshop/CLAIMS-AND-LIMITS.md.
# MAF_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
# MAF_API_KEY=<organiser supplies; never commit it>
# MAF_MODEL=gpt-5.4-mini
